name: Homero — Traducción, Audiolibro, Karaoke, EPUB y PDF

on:
  push:
    branches:
      - main
    paths:
      - "capitulos/es/**"
      - "libro.yaml"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  compilar-libro:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repositorio del libro
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Ejecutar motor Homero (Auto-traducción y Compilación)
        uses: elswork/homero.deft.work@main
        with:
          book_dir: "."
          translate: "true"
          source_lang: "es"

      - name: Guardar traducciones, audiolibro, karaoke, EPUB y PDF en GitHub
        run: |
          git config user.name "Homero Bot (.ia)"
          git config user.email "elswork@gmail.com"
          git add capitulos/ audio/ descargas/ homero-bundle.js
          if ! git diff --cached --quiet; then
            git commit -m "chore(homero): auto-traducción a 8 idiomas, audiolibro, karaoke, EPUB y PDF [skip ci]"
            git push
          fi
